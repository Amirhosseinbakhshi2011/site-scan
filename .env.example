# Aegis Sentinel AI - Environment Configuration
# Copy to .env and fill values. NEVER commit real .env

# Application
APP_NAME="Aegis Sentinel AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# Database (SQLite for easy start, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/aegis.db
# DATABASE_URL=postgresql+asyncpg://aegis:password@localhost:5432/aegis_sentinel

# Redis (optional for Celery)
REDIS_URL=redis://localhost:6379/0

# Scanner Safety Limits
SCANNER_MAX_CONCURRENT_REQUESTS=5
SCANNER_REQUEST_TIMEOUT=15
SCANNER_MAX_RESPONSE_SIZE_KB=512
SCANNER_RATE_LIMIT_PER_DOMAIN=10
SCANNER_USER_AGENT="Aegis-Sentinel-AI/1.0 (Authorized Security Assessment; +https://your-domain.example)"

# Domain Verification
DOMAIN_VERIFICATION_TOKEN_PREFIX=aegis-verify-
DOMAIN_VERIFICATION_FILE_PATH=/.well-known/aegis-sentinel-verification.txt

# Auth
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMeImmediately123!

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS (restrict in production)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
